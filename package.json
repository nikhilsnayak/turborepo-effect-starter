{
  "name": "turborepo-effect-starter",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "oxlint --deny-warnings --config oxlint.config.ts",
    "lint:fix": "oxlint --fix --config oxlint.config.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run lint && bun run fmt:check",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "vendor:sync": "bun scripts/sync-vendor.ts",
    "prepare": "effect-tsgo patch --oxlint"
  },
  "dependencies": {
    "@effect/tsgo": "0.36.4",
    "@types/bun": "catalog:",
    "oxfmt": "^0.63.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.9",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@effect/atom-react": "4.0.0-rc.109",
    "@effect/platform-bun": "4.0.0-rc.109",
    "@effect/sql-pg": "4.0.0-rc.109",
    "@effect/vitest": "4.0.0-rc.109",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "effect": "4.0.0-rc.109",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
