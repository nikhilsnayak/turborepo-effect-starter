{
  "name": "turborepo-effect-starter",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "effect-tsgo --tsrs-lint oxlint --deny-warnings --config oxlint.config.ts",
    "lint:fix": "effect-tsgo --tsrs-lint oxlint --fix --config oxlint.config.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run lint && bun run fmt:check && bun run --cwd apps/server db:check",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "vendor:sync": "bun scripts/sync-vendor.ts"
  },
  "dependencies": {
    "@effect/tsgo": "0.73.4",
    "@types/bun": "catalog:",
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxfmt": "^0.79.0",
    "oxlint": "1.94.0",
    "tsrs": "^7.1.0-beta.tsrs4",
    "turbo": "^2.11.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@effect/atom-react": "4.1.5",
    "@effect/vitest": "4.1.5",
    "@types/bun": "^1.4.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "effect": "4.1.5",
    "lucide-react": "^1.77.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  }
}
