{
  "name": "turborepo-effect-starter",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "oxlint --deny-warnings --config oxlint.config.ts",
    "lint:fix": "oxlint --fix --config oxlint.config.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run lint && bun run fmt:check",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "vendor:sync": "bun scripts/sync-vendor.ts",
    "prepare": "effect-tsgo patch --oxlint"
  },
  "dependencies": {
    "@effect/tsgo": "0.47.2",
    "@types/bun": "catalog:",
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxfmt": "^0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "turbo": "^2.11.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@effect/atom-react": "4.0.0",
    "@effect/vitest": "4.0.0",
    "@types/bun": "^1.4.2",
    "@types/react": "19.2.4",
    "@types/react-dom": "^19.3.0",
    "effect": "4.0.0",
    "lucide-react": "^1.49.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "patchedDependencies": {
    "drizzle-orm@1.0.0-rc.5-5935859": "patches/drizzle-orm@1.0.0-rc.5-5935859.patch"
  }
}
