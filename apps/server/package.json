{
  "name": "server",
  "private": true,
  "type": "module",
  "imports": {
    "#db": "./src/lib/db/index.ts",
    "#internal/*": "./src/*",
    "#lib/*": "./src/lib/*",
    "#modules/*": "./src/modules/*"
  },
  "scripts": {
    "build": "bun build src/index.ts --compile --outfile dist/server",
    "dev": "bun run --watch src/index.ts",
    "start": "./dist/server",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check && { drizzle-kit generate --explain --output json | grep -q '\"status\":\"no_changes\"' || { echo 'Schema has changes without a migration; run bun run db:generate.' >&2; exit 1; }; }",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest --watch"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.5",
    "@effect/sql-pg": "4.1.5",
    "@effect/sql-pglite": "4.1.5",
    "@effect/vitest": "catalog:",
    "@electric-sql/pglite": "^0.5.17",
    "@repo/contracts": "workspace:*",
    "@types/bun": "catalog:",
    "drizzle-kit": "1.0.0-rc.6",
    "drizzle-orm": "1.0.0-rc.6",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
